# Copy this file to .env and fill in your own values.
# These are read ONLY by the serverless functions in /api (never by the browser).
# Do NOT add the VITE_ prefix: Vite would bundle them into the public JavaScript.

# Claude API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs API key — https://elevenlabs.io/app/settings/api-keys
# Tip: create a restricted key with only Text to Speech access and a credit limit.
ELEVENLABS_API_KEY=

# ElevenLabs voice ID (not secret) — find it in the Voices library
ELEVENLABS_VOICE_ID=

# Upstash Redis (cuenta las velas) — Vercel → Storage → tu base Upstash → pestaña .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
